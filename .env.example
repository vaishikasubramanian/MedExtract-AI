# ──────────────────────────────────────────────────────────────────
# MedExtract-AI Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to `.env` in the project root and fill in values.
# Every variable is prefixed with MEDEXTRACT_ and maps to a setting in
# src/config.py.  Environment variables override config.yaml values.
# ──────────────────────────────────────────────────────────────────

# ── Secrets / External Paths ─────────────────────────────────────
# Path to the Tesseract OCR binary (if not on PATH)
# MEDEXTRACT_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Path to the Poppler bin directory (for pdf2image on Windows)
# MEDEXTRACT_POPPLER_PATH=C:/tools/poppler/Library/bin

# ── General ───────────────────────────────────────────────────────
# MEDEXTRACT_LOG_LEVEL=INFO
# MEDEXTRACT_LOG_FORMAT=text          # text | json (json for production / log aggregators)
# MEDEXTRACT_VERSION=1.0.0

# ── Paths ─────────────────────────────────────────────────────────
# MEDEXTRACT_INPUT_DIR=data/generated
# MEDEXTRACT_OUTPUT_DIR=output
# MEDEXTRACT_TEMP_DIR=/tmp/medextract

# ── Pipeline ──────────────────────────────────────────────────────
# MEDEXTRACT_OCR_DPI=300
# MEDEXTRACT_OCR_LANG=eng+spa
# MEDEXTRACT_RUN_INFERENCE=true
# MEDEXTRACT_MAX_WORKERS=4

# ── FHIR ─────────────────────────────────────────────────────────
# MEDEXTRACT_FHIR_BUNDLE=true
# MEDEXTRACT_FHIR_OUTPUT_DIR=medextract_fhir

# ── API Server ────────────────────────────────────────────────────
# MEDEXTRACT_API_HOST=0.0.0.0
# MEDEXTRACT_API_PORT=8000
# MEDEXTRACT_API_WORKERS=1
# MEDEXTRACT_API_RELOAD=false
