# ══════════════════════════════════════════════════════════════════
# MedExtract-AI – Production Environment
# ══════════════════════════════════════════════════════════════════
# Copy to .env in the project root before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# ══════════════════════════════════════════════════════════════════

# ── Logging ──────────────────────────────────────────────────────
MEDEXTRACT_LOG_LEVEL=INFO
MEDEXTRACT_LOG_FORMAT=json

# ── API Server ───────────────────────────────────────────────────
MEDEXTRACT_API_HOST=0.0.0.0
MEDEXTRACT_API_PORT=8000
MEDEXTRACT_API_WORKERS=2
MEDEXTRACT_API_RELOAD=false

# ── Pipeline ─────────────────────────────────────────────────────
MEDEXTRACT_OCR_DPI=300
MEDEXTRACT_OCR_LANG=eng+spa
MEDEXTRACT_RUN_INFERENCE=true
# MEDEXTRACT_MAX_WORKERS=4           # Uncomment to cap thread pool (default: cpu_count * 2)
# MEDEXTRACT_MODEL_PATH=             # Path to custom model weights

# ── Export ───────────────────────────────────────────────────────
MEDEXTRACT_EXPORT_FORMAT=json
MEDEXTRACT_OUTPUT_DIR=/app/output

# ── FHIR ─────────────────────────────────────────────────────────
MEDEXTRACT_FHIR_BUNDLE=true
MEDEXTRACT_FHIR_OUTPUT_DIR=medextract_fhir

# ── Nginx (used by docker-compose.prod.yml) ──────────────────────
NGINX_PORT=80
# NGINX_SSL_PORT=443            # Uncomment when TLS certs are mounted
